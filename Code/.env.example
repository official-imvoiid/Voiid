# server.js settings. Copy this file to .env and fill it in.
# .env is git-ignored - never commit it.
#
# Make random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Make Admin Password
# node -e "const c=require('crypto');let p;do{p=c.randomBytes(18).toString('base64')}while(!(/[a-z]/.test(p)&&/[A-Z]/.test(p)&&/[0-9]/.test(p)&&/[+\/]/.test(p)));console.log(p)"

# Password for the Inbox in /admin (checked by the server)
ADMIN_PASSWORD=pick-a-long-password

# Encrypts saved messages (data/messages.enc). EXACTLY 64 hex characters.
# Keep a copy somewhere safe - lose it and the saved messages can't be read.
MESSAGES_KEY=put-64-hex-characters-here

# Signs the contact form's robot-check questions. Any long random string.
CHALLENGE_SECRET=put-a-long-random-string-here

# Port for server.js (Vite forwards /api to it in dev)
PORT=5001

# Behind nginx, Cloudflare or a host's proxy? The number of proxies in front of
# the server (usually 1), so rate limits count visitors rather than the proxy.
# Leave at 0 when the server is reached directly.
TRUST_PROXY_HOPS=0

# Set to production on the live server (the admin cookie is then always Secure)
# NODE_ENV=production
